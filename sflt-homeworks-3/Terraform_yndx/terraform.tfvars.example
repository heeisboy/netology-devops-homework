# Скопируйте этот файл в terraform.tfvars и заполните своими значениями:
#   cp terraform.tfvars.example terraform.tfvars
#
# Полное описание каждого параметра и всех допустимых значений — в variables.tf.
# Здесь для параметров с выбором приведены варианты значений: активна (не
# закомментирована) только ОДНА строка на параметр — остальные закомментированы
# как подсказка. Чтобы сменить значение — закомментируйте текущую строку и
# раскомментируйте нужную.

# ---------------------------------------------------------------------------
# Аутентификация и адрес ресурсов — ОБЯЗАТЕЛЬНО заполнить
# ---------------------------------------------------------------------------

yc_cloud_id  = "b1gxxxxxxxxxxxxxxxxx" # консоль → обзор облака, либо `yc config list`
yc_folder_id = "b1gyyyyyyyyyyyyyyyyy" # консоль → каталог → настройки, либо `yc config list`

# Способ авторизации — выберите ОДИН из двух (второй оставьте закомментированным):
yc_service_account_key_file = "authorized_key.json" # рекомендуемый способ, см. README-пояснения в providers.tf
# yc_token = "y0_..."                                # альтернатива: OAuth/IAM-токен (лучше через env YC_TOKEN, не тут)

yc_zone = "ru-central1-a"
# yc_zone = "ru-central1-b"
# yc_zone = "ru-central1-d"

# ---------------------------------------------------------------------------
# Виртуальная машина
# ---------------------------------------------------------------------------

vm_name = "example-vm"

vm_platform_id = "standard-v3" # актуальное поколение CPU (Ice Lake)
# vm_platform_id = "standard-v2" # Cascade Lake
# vm_platform_id = "standard-v1" # Broadwell, дешевле/старее

# Пресет "мало ресурсов" (дёшево, для тестов/учебных задач)
vm_cores  = 2
vm_memory = 2
# Пресет "средний" — раскомментируйте вместо строк выше
# vm_cores  = 4
# vm_memory = 8
# Пресет "мощный"
# vm_cores  = 8
# vm_memory = 16

vm_core_fraction = 100 # полная гарантированная мощность CPU
# vm_core_fraction = 50  # дешевле, ядро "разгоняется" при нагрузке
# vm_core_fraction = 20  # ещё дешевле, для лёгких задач
# vm_core_fraction = 5   # минимум, для редкой фоновой нагрузки

# ---------------------------------------------------------------------------
# Диск
# ---------------------------------------------------------------------------

boot_disk_type = "network-hdd" # самый дешёвый
# boot_disk_type = "network-ssd"               # быстрее
# boot_disk_type = "network-ssd-nonreplicated" # ещё быстрее, менее надёжен
# boot_disk_type = "local-ssd"                 # максимальная скорость, диск живёт только с ВМ

boot_disk_size = 20 # ГБ

# ---------------------------------------------------------------------------
# Образ ОС и SSH-доступ (ssh_user должен соответствовать выбранному образу)
# ---------------------------------------------------------------------------

image_family = "ubuntu-2204-lts"
ssh_user     = "ubuntu"
# image_family = "ubuntu-2404-lts"
# ssh_user     = "ubuntu"

# image_family = "debian-12"
# ssh_user     = "debian"

# image_family = "centos-stream-9"
# ssh_user     = "centos"

ssh_public_key_path = "~/.ssh/id_rsa.pub"
# ssh_private_key_path = "~/.ssh/id_rsa" # если не задано — ssh_public_key_path без ".pub" (для Ansible)

generate_ansible_inventory = true # ansible/inventory.ini со списком созданных ВМ, см. ansible/playbook.yml

# ---------------------------------------------------------------------------
# Сеть
# ---------------------------------------------------------------------------

network_cidr = "10.10.0.0/24"

assign_public_ip = true # false — ВМ без внешнего IP, доступ только из внутренней сети/VPN

# ---------------------------------------------------------------------------
# Target-группа (для Network Load Balancer)
# ---------------------------------------------------------------------------

create_target_group = true # false — target-группу не создавать
# target_group_name = "example-vm-target-group" # если не задано — "<vm_name>-target-group"

# ---------------------------------------------------------------------------
# Сетевой балансировщик нагрузки
# ---------------------------------------------------------------------------

create_load_balancer = true # false — балансировщик не создавать (требует create_target_group = true)
# lb_name = "example-vm-lb" # если не задано — "<vm_name>-lb"
