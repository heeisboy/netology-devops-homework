# Настройка подключения (аутентификации) к Yandex Cloud.
#
# У провайдера yandex ЕСТЬ ДВА взаимоисключающих способа авторизации —
# заполняется только один из них (второй должен остаться null):
#
#   1) token                    — OAuth- или IAM-токен пользователя.
#      Просто для разового/ручного запуска, но IAM-токен живёт всего
#      ~12 часов, а OAuth-токен привязан к конкретному человеку.
#   2) service_account_key_file — путь к JSON-ключу сервисного аккаунта.
#      Рекомендуемый способ для Terraform: не протухает быстро, не привязан
#      к личному аккаунту, легко выдать/отозвать отдельному сервис-юзеру.
#
# Какой способ активен — определяется тем, какая переменная задана в
# terraform.tfvars (см. этот файл — там сейчас используется способ №2).
#
# Если явно не передать cloud_id/folder_id/zone — провайдер попробует
# подхватить их из переменных окружения YC_CLOUD_ID / YC_FOLDER_ID / YC_ZONE
# (удобно для CI, где tfvars не хранят).
provider "yandex" {
  token                    = var.yc_token                    # способ №1 (см. выше)
  service_account_key_file = var.yc_service_account_key_file # способ №2 (см. выше) — используется сейчас
  cloud_id                 = var.yc_cloud_id
  folder_id                = var.yc_folder_id
  zone                     = var.yc_zone
}
